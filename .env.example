DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/guru_core
REDIS_URL=redis://127.0.0.1:6379/0
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./.data/storage
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8000/v1/files
STORAGE_SIGNING_SECRET=dev-storage-secret-change-me
# Switching to Cloudflare R2 needs nothing but configuration: set STORAGE_BACKEND=r2 and fill in
# the four R2_* variables below. No application code changes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
JWT_SECRET=dev-jwt-secret-change-me
JWT_TTL_SECONDS=2592000
OAUTH_TOKEN_ENC_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/v1/integrations/google/callback
ROLE_MODEL_API_KEY=dev-role-model-key
ROLE_MODEL_BASE_URL=http://127.0.0.1:8001
# Requests allowed per caller per minute; 0 or less disables rate limiting.
RATE_LIMIT_PER_MINUTE=60
# LOCAL SMOKE TESTING ONLY - NEVER SET THIS TO 1 IN PRODUCTION.
# When enabled, POST /v1/auth/google accepts {"code": "fake:<email>"} and signs the caller in
# as that email without contacting Google, so anyone can log in as anyone.
ALLOW_FAKE_LOGIN=0
# LLM. Every value has a default in config/llm.yaml; set only what you change.
# Local demo baseline is Ollama + qwen3.5:9b (docs/research/local-llm-evaluation.md).
# Tests keep LLM_ADAPTER=fake so they never reach a provider.
LLM_ADAPTER=fake                                  # openai_compat | anthropic | fake
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b
LLM_STRUCTURED_OUTPUT=json_schema                 # guided_json | json_schema | tool_use | prompt
LLM_MAX_CONTEXT=16384
LLM_TIMEOUT=240
LLM_CONCURRENCY=1                                 # 0 = uncapped, for a hosted provider
LLM_REASONING_EFFORT=none                         # blank = do not send the field at all
