DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/guru_core
REDIS_URL=redis://127.0.0.1:6379/0
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./.data/storage
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8000/v1/files
STORAGE_SIGNING_SECRET=dev-storage-secret-change-me
# Switching to Cloudflare R2 needs nothing but configuration: set STORAGE_BACKEND=r2 and fill in
# the four R2_* variables below. No application code changes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
JWT_SECRET=dev-jwt-secret-change-me
JWT_TTL_SECONDS=2592000
OAUTH_TOKEN_ENC_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The calendar/sheets consent redirect. Google sends the browser here with GET, and
# POST /v1/integrations/google/callback is POST-only, so this is a *frontend* page
# that forwards the code to the API. Must match the Google console entry exactly.
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/google/callback
# The Catalog Service authenticates its writes with this; reads are open.
CATALOG_API_KEY=dev-catalog-key
# Requests allowed per caller per minute; 0 or less disables rate limiting.
RATE_LIMIT_PER_MINUTE=60
# LOCAL SMOKE TESTING ONLY - NEVER SET THIS TO 1 IN PRODUCTION.
# When enabled, POST /v1/auth/google accepts {"code": "fake:<email>"} and signs the caller in
# as that email without contacting Google, so anyone can log in as anyone.
ALLOW_FAKE_LOGIN=0
# LLM. Every value has a default in config/llm.yaml; set only what you change.
# `.env` is loaded into the process environment by every cmd/ entry point, so these reach
# both pydantic-settings and the ${VAR} expansion inside config/*.yaml.
# Hosted baseline is xAI grok-4.6 over its OpenAI-compatible endpoint; set
# LLM_ADAPTER=openai_compat and LLM_API_KEY to run against it. Tests keep
# LLM_ADAPTER=fake so they never reach a provider.
LLM_ADAPTER=fake                                  # openai_compat | anthropic | fake
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=                                      # xai-... — never commit a real key
LLM_MODEL=grok-4.6
LLM_STRUCTURED_OUTPUT=json_schema                 # guided_json | json_schema | tool_use | prompt
LLM_MAX_CONTEXT=500000
LLM_TIMEOUT=240
LLM_CONCURRENCY=0                                 # 1 for a local runtime with one KV cache
LLM_REASONING_EFFORT=low                          # blank = do not send the field at all
