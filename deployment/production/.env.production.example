# Copy to .env.production on the Droplet and fill in. Never commit the filled copy.
#   cp .env.production.example .env.production

# Image built on the Droplet by `make deploy-build env=production`.
IMAGE_NAME=guru-core
IMAGE_TAG=latest

# Public entrypoint. No domain and no TLS yet, so this is the Droplet's IP.
# It is what signed file URLs and the Google OAuth redirect are built from.
PUBLIC_BASE_URL=http://203.0.113.10:8000
# 0.0.0.0 publishes to the internet; narrow it if you put something in front later.
API_BIND=0.0.0.0
API_PORT=8000

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=guru_core

# Redis
REDIS_PASSWORD=replace-with-strong-password

# Secrets. These three: openssl rand -base64 32
JWT_SECRET=replace-with-jwt-secret
JWT_TTL_SECONDS=2592000
STORAGE_SIGNING_SECRET=replace-with-storage-signing-secret
ROLE_MODEL_API_KEY=replace-with-role-model-api-key
# A Fernet key, not plain base64 — the API refuses to boot without it.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENC_KEY=replace-with-fernet-key

# Storage: local disk under deployment/production/data/storage, or r2.
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Google OAuth. One client covers both grants; register both redirect URIs on it.
#  - Sign-in: the frontend runs the flow and passes its own redirect_uri per request,
#    so nothing is configured here. Register the frontend's callback URL in the console.
#  - Calendar / Sheets: GOOGLE_REDIRECT_URI below is what the backend puts in the
#    consent URL. Google redirects there with GET, and POST /v1/integrations/google/callback
#    is POST-only, so point this at a frontend page that forwards the code to the API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Requests allowed per caller per minute; 0 or less disables rate limiting.
RATE_LIMIT_PER_MINUTE=60

# LLM. config/llm.yaml already defaults to the hosted xAI grok-4.6 baseline, so
# the API key is the only value that has to be set. The rest are spelled out
# here to make the deployed configuration readable at a glance.
LLM_ADAPTER=openai_compat
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=replace-with-xai-api-key
LLM_MODEL=grok-4.6
LLM_STRUCTURED_OUTPUT=json_schema
LLM_MAX_CONTEXT=500000
LLM_TIMEOUT=240
# 0 = uncapped, correct for a hosted provider.
LLM_CONCURRENCY=0
# grok-4.6 rejects "none" — it always reasons. Blank stops the field being sent
# at all, for a provider that does not accept it.
LLM_REASONING_EFFORT=low
